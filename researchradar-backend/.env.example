XAI_API_KEY=your_actual_grok_api_key
# Optional: set a secret key to guard POST /api/analyze and POST /api/experiments.
# Leave empty to disable auth (local dev / demo). Required in production.
API_KEY=

XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=your_available_grok_model_id

EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
REQUEST_TIMEOUT_SECONDS=25.0
MAX_PAPERS=20
MAX_ABSTRACT_CHARS=3500
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///./data/researchradar.db
